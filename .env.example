# Runtime - required in development, test, staging, and production
# Use different secret values in every environment.
DATABASE_URL=
NEXTAUTH_URL=
NEXTAUTH_SECRET=
# Development only: use in-process Redis and make the app independent of the internet.
# Never enable this in a deployed environment.
ONEFLOWE_OFFLINE_MODE=false
# Required unless ONEFLOWE_OFFLINE_MODE=true.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=

# Runtime - optional tuning
PGPOOL_MAX=
PGPOOL_IDLE_MS=
PGPOOL_CONN_TIMEOUT_MS=
PG_STATEMENT_TIMEOUT_MS=
BCRYPT_ROUNDS=
# Bcrypt execution backend: auto (default) | native | bcryptjs
# Digests are identical either way; this only selects where hashing runs.
# Set to bcryptjs to force the legacy in-process backend without a rebuild.
PASSWORD_HASHER=
# Global fallback for users without a tenant override (integer, 1-15; default 15)
INACTIVITY_TIMEOUT_MINUTES=
# Positive identity-validation cache (0-30 seconds; default 30)
SESSION_VALIDATION_CACHE_TTL_SECONDS=
RATE_LIMIT_TRUST_PROXY_HOPS=
# Per-account brute-force lockout. Values outside the ranges below are
# rejected at startup. The attempt threshold stays within PCI DSS 8.3.4; the
# duration floor deliberately does not -- see lib/auth-lockout-policy.ts.
# Failed attempts before the account locks (integer, 3-10; default 5)
AUTH_LOCKOUT_THRESHOLD=
# How long the account stays locked (integer minutes, 5-1440; default 5)
AUTH_LOCKOUT_DURATION_MINUTES=
ORDER_TOKEN_ADMIN_EMAIL=

# Runtime - AWS integrations (SES email, S3 uploads)
# Use an IAM workload identity, AWS SSO, or a local AWS profile for credentials.
# AWS_REGION is shared by SES and S3; set it if either is in use.
AWS_REGION=
SES_FROM_EMAIL=
SES_CONFIGURATION_SET=

# Runtime - S3 image uploads. Without this, uploads fall back to inline data
# URLs in development and are refused outright in production.
# S3_UPLOADS_BUCKET comes from the `uploads_bucket_name` Terraform output.
# S3_UPLOADS_REGION is only needed when the bucket is in a different region
# than SES; it falls back to AWS_REGION when unset.
S3_UPLOADS_BUCKET=
S3_UPLOADS_REGION=

# Migration tooling only - never configure this on the application runtime
MIGRATION_DATABASE_URL=

# One-time administrator bootstrap only - remove immediately after use
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
